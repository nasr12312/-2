[{"id":"rahman","label":"الرحمن • تعليم القرآن","reference":"الرحمن: ١–٤","verses":[{"surah":55,"ayah":1,"text":"ٱلرَّحْمَٰنُ","basmalah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ"},{"surah":55,"ayah":2,"text":"عَلَّمَ ٱلْقُرْءَانَ"},{"surah":55,"ayah":3,"text":"خَلَقَ ٱلْإِنسَٰنَ"},{"surah":55,"ayah":4,"text":"عَلَّمَهُ ٱلْبَيَانَ"}]},{"id":"prayer","label":"طه • دعاء التيسير","reference":"طه: ٢٥–٢٨","verses":[{"surah":20,"ayah":25,"text":"قَالَ رَبِّ ٱشْرَحْ لِى صَدْرِى"},{"surah":20,"ayah":26,"text":"وَيَسِّرْ لِىٓ أَمْرِى"},{"surah":20,"ayah":27,"text":"وَٱحْلُلْ عُقْدَةًۭ مِّن لِّسَانِى"},{"surah":20,"ayah":28,"text":"يَفْقَهُوا۟ قَوْلِى"}]},{"id":"knowledge","label":"طه • طلب العلم","reference":"طه: ١١٤","verses":[{"surah":20,"ayah":114,"text":"فَتَعَٰلَى ٱللَّهُ ٱلْمَلِكُ ٱلْحَقُّ ۗ وَلَا تَعْجَلْ بِٱلْقُرْءَانِ مِن قَبْلِ أَن يُقْضَىٰٓ إِلَيْكَ وَحْيُهُۥ ۖ وَقُل رَّبِّ زِدْنِى عِلْمًۭا"}]},{"id":"reading","label":"العلق • اقرأ","reference":"العلق: ١–٥","verses":[{"surah":96,"ayah":1,"text":"ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","basmalah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ"},{"surah":96,"ayah":2,"text":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ"},{"surah":96,"ayah":3,"text":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ"},{"surah":96,"ayah":4,"text":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ"},{"surah":96,"ayah":5,"text":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ"}]},{"id":"guidance","label":"الإسراء • هداية القرآن","reference":"الإسراء: ٩","verses":[{"surah":17,"ayah":9,"text":"إِنَّ هَٰذَا ٱلْقُرْءَانَ يَهْدِى لِلَّتِى هِىَ أَقْوَمُ وَيُبَشِّرُ ٱلْمُؤْمِنِينَ ٱلَّذِينَ يَعْمَلُونَ ٱلصَّٰلِحَٰتِ أَنَّ لَهُمْ أَجْرًۭا كَبِيرًۭا"}]},{"id":"ease","label":"الشرح • اليسر","reference":"الشرح: ٥–٦","verses":[{"surah":94,"ayah":5,"text":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا"},{"surah":94,"ayah":6,"text":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا"}]}]